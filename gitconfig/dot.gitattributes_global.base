# -*- mode: Gitattributes -*-

# linguist (GitHub) ============================================================
/docs/** linguist-documentation
/dist/** export-ignore linguist-generated

# ipynb ========================================================================
*.ipynb filter=nbstripout diff=ipynb

# transcrypt ===================================================================
*.cert filter=crypt diff=crypt merge=crypt -delta export-ignore
*.crt filter=crypt diff=crypt merge=crypt -delta export-ignore
*.gpg filter=crypt diff=crypt merge=crypt -delta export-ignore
*.key filter=crypt diff=crypt merge=crypt -delta export-ignore
*.secret filter=crypt diff=crypt merge=crypt -delta export-ignore
*.secret.* filter=crypt diff=crypt merge=crypt -delta export-ignore
**/*.secret/** filter=crypt diff=crypt merge=crypt -delta export-ignore
**/.git* !filter !diff
