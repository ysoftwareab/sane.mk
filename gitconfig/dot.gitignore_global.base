# -*- mode: Gitignore -*-

# Slimmer versions of https://github.com/github/gitignore
# see https://github.com/github/gitignore/pull/1980#issuecomment-668782387

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*
# Org-mode
.org-id-locations
*_archive
# flymake-mode
*_flymake.*
# Flycheck
flycheck_*.el
# projectiles files
.projectile
# directory configuration
.dir-locals.el

# NodeJS
.npm/
.tern-port
node_modules/
npm-debug.log*

# Python
__pycache__/
.ruff_cache/
.venv/
ipynb_checkpoints/

# Terraform
.infracost/
.terraform/
.terraformrc
terraform.rc
override.tf*
override.tofu*
*_override.tf*
*_override.tofu*
*.tflog*
*.tfplan*
*.tfstate*
*.tfvars*

# ZZ
*.log*
Makefile.lazy
tmp/

# ZZ git
*.gitignored*
/.git-worktree/
/archive.*
