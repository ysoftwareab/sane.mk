# -*- mode: ruby -*-

brew "awscli" # Official Amazon AWS command-line interface
brew "infracost" # Cost estimates for Terraform
brew "tenv" # OpenTofu / Terraform / Terragrunt / Terramate / Atmos version manager
brew "terraform-docs" # Tool to generate documentation from Terraform modules
cask "gcloud-cli" if OS.mac? # Set of tools to manage resources and applications hosted on Google Cloud
