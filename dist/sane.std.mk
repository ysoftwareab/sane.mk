	-e "s|^aarch64$$|arm64|" \
	-e "s|^arm64/v8$$|arm64|" \
	-e "s|^armhf$$|arm|" \
	-e "s|^arm64/v7$$|arm|" \
	-e "s|^armel$$|arm/v6|" \
	-e "s|^i386$$|386|" \
