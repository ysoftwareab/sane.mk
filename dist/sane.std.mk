	$(MAKE_DASH_F) posthook/$@


.PHONY: build
build: prehook/build
build: ## Build.
	$(MAKE_DASH_F) $(SANE_BUILD)
	$(MAKE_DASH_F) posthook/$@


.PHONY: test
test: prehook/test
test: ## Test.
	$(MAKE_DASH_F) $(SANE_TEST)
	$(MAKE_DASH_F) posthook/$@

.PHONY: dist
