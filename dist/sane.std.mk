# BEGIN # target.std.inc.mk
SANE_BUILD ?= noop
SANE_CHECK ?= noop
SANE_CLEAN ?= noop
SANE_DEBUG ?= noop
SANE_DEPS_FILES ?= noop
SANE_DEPS_FOLDERS ?= noop
SANE_DEPS_GITIGNORE ?= noop
SANE_DEPS_UPGRADE ?= noop
SANE_DIST ?= noop
SANE_SYSTEM ?= noop
SANE_TEST ?= noop

SANE_ALL_DEFAULT := deps check build
SANE_ALL ?= noop $(SANE_ALL_DEFAULT)

SANE_CI_DEFAULT := all test
