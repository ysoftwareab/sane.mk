	$(MAKE_DASH_F) posthook/$@


.PHONY: deps/gitignore
deps/gitignore: prehook/deps/gitignore
deps/gitignore:
	$(MAKE_DASH_F) $(SANE_DEPS_GITIGNORE)
	$(MAKE_DASH_F) posthook/$@


.PHONY: deps/upgrade
deps/upgrade: prehook/deps/upgrade
