	$(shell $(GIT_LS) $(MARKDOWNLINT_FILES_SHEBANG_PATH) | \
		while read -r FILE; do \
		[[ ! -L "$${FILE}" ]] || continue; \
		[[ -f "$${FILE}" ]] || continue; \
		$(HEAD) -n1 "$${FILE}" | $(GREP) -q -e "^<!-- -\\*- mode: markdown -\\*- -->$$" || continue; \
		$(ECHO) "$${FILE}"; \
	done)

