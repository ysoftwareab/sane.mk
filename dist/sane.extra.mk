# BEGIN # exe.which.inc.mk
# WHICH_Q is kept for backward compatibility
WHICH_Q := 2>/dev/null which
COMMAND_Q := 2>/dev/null command -v

# NOTE can't use $(ECHO)
define global-which
$(shell \
	hash -r; \
	export RESULT="$$(for CMD in $(2); do $(COMMAND_Q) $${CMD} && break || continue; done)"; \
	echo "$${RESULT:-$(1)_NOT_FOUND}")
endef
PRINTVARS_VARIABLES_IGNORE += global-which

# NOTE can't use $(ECHO)
define which
$(shell \
	export PATH="$(PATH)"; \
	hash -r; \
	export RESULT="$$(for CMD in $(2); do $(COMMAND_Q) $${CMD} && break || continue; done)"; \
	echo "$${RESULT:-$(1)_NOT_FOUND}")
endef
PRINTVARS_VARIABLES_IGNORE += which
# END # exe.which.inc.mk

# BEGIN # exe.echo.inc.mk
# ECHO2 can be used for e.g. pointing to
# an executable that outputs teamcity messages

ECHO2 ?= $(ECHO) $$($(DATE) "+%H:%M:%S")
ECHO_DO = $(ECHO2) -- "[DO  ]"
ECHO_DONE = $(ECHO2) -- "[DONE]"
ECHO_INDENT = $(ECHO) -n "$$($(DATE) "+%H:%M:%S") -- [XXXX] " | $(SED) "s/./ /g" && $(ECHO)
ECHO_NEXT = $(ECHO2) -- "[NEXT]"
ECHO_Q = $(ECHO2) -- "[Q   ]"
ECHO_SKIP = $(ECHO2) -- "[SKIP]"

ECHO_ERR = $(ECHO2) -- "[ERR ]"
ECHO_INFO = $(ECHO2) -- "[INFO]"
ECHO_WARN = $(ECHO2) -- "[WARN]"
# END # exe.echo.inc.mk

