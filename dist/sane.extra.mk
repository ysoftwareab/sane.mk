# BEGIN # target.noop.inc.mk
# noop TARGET
# Usage:
# my-target: my-optional-target | noop
.PHONY: noop
noop:
	@:

# noop/% TARGET
# Usage:
# my-target: noop/my-optional-target
.PHONY: noop/%
noop/%:
	@$(ECHO_INFO) "Skipping $*..."
	@:

# skip/% TARGET, alias to noop/%
# Usage:
