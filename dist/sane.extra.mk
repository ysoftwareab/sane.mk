	$(ECHO) "RUFF_FILES_EXT=$(RUFF_FILES_EXT)"
	$(ECHO) "RUFF_FILES_FILTER_OUT=$(RUFF_FILES_FILTER_OUT)"
	$(ECHO) "RUFF_FILES_SHEBANG=$(RUFF_FILES_SHEBANG)"
	$(ECHO) "RUFF_FLAGS=$(RUFF_FLAGS)"
